source 'https://rubygems.org'

gem 'jekyll', '~> 3.0'
gem 'jekyll-paginate'
gem 'jekyll-sitemap'

# Jekyll defaults kramdown's input to GFM but does not depend on the parser
# itself. Until the Danger gems were removed this rode in as a transitive
# dependency of theirs, and the build broke the moment they left.
gem 'kramdown-parser-gfm'
